# LLM API Keys (for cloud providers)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama Local LLM Configuration
# OLLAMA_API_KEY is optional for local Ollama (can be set to "ollama" or left empty)
OLLAMA_API_KEY=ollama
# OLLAMA_BASE_URL must end with /v1 for OpenAI-compatible API
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Default LLM provider and model
# Options: openai, anthropic, openrouter, ollama
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=google/gemma-4-26b-a4b-it:free

# Ollama default model (when using ollama provider)
# Common options: llama3.1, mistral, codellama, deepseek-coder, phi4
OLLAMA_DEFAULT_MODEL=llama3.1

# Pipeline defaults
OUTPUT_DIR=./output
FIGURES_DIR=./figures
LOG_LEVEL=INFO